# Copy this file to `.env` and fill in your own values.
# Never commit `.env` or paste its contents into chat/frontend code.

# Required for AI-written explanations. Without it, the copilot still works in
# clearly-labelled local-analysis mode using the app's recorded shopping data.
OPENROUTER_API_KEY=

# Optional. If omitted, the app uses OpenRouter's automatic router.
# Set this to the exact model id already available in your OpenRouter account.
OPENROUTER_MODEL=openrouter/auto

# Optional request metadata shown in the OpenRouter dashboard.
OPENROUTER_SITE_URL=http://localhost:8501
OPENROUTER_APP_NAME=AI Smart Deal Predictor

# Optional: override the chat-completions endpoint (proxy or local test server).
# OPENROUTER_API_URL=https://openrouter.ai/api/v1/chat/completions

# Optional: request timeout in seconds, clamped to 5-120.
# AI_COPILOT_TIMEOUT=45

# Optional: override the SQLite file location.
# SHOPPING_DB_PATH=data/shopping.db

# ---------------------------------------------------------------------------
# Live marketplace quotes
# ---------------------------------------------------------------------------
# Live imports fetch public product pages on demand. They respect robots.txt,
# rate-limit per host, and never bypass CAPTCHAs, logins, or anti-bot controls.
# Retailer terms may still restrict automated access; use official APIs or
# affiliate feeds for production use.

# Request timeout in seconds, clamped to 5-60.
# LIVE_SCRAPER_TIMEOUT=15

# Minimum delay between requests to the same host, clamped to 0-60 seconds.
# LIVE_SCRAPER_MIN_INTERVAL=2.0

# Maximum HTML response size accepted, clamped to 100 KB-10 MB.
# LIVE_SCRAPER_MAX_BYTES=3000000

# A quote older than this is shown as stale, clamped to 1-168 hours.
# LIVE_QUOTE_STALE_HOURS=24

# Set to 0 only for controlled testing. Production should keep robots checks on.
# LIVE_SCRAPER_CHECK_ROBOTS=1

# Optional descriptive user agent. Leave blank to use the app's default.
# LIVE_SCRAPER_USER_AGENT=
